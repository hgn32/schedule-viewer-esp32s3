#pragma once
// このファイルのコピーを`secrets.h`として作り、自分の環境の値を入れる。
// `secrets.h`は資格情報を含むため.gitignoreで追跡から外してある。
//
//   cp main/secrets.h.example main/secrets.h

// --- Wi-Fi (WPA2-PSK) -------------------------------------------------------
#define WIFI_SSID     "YOUR_SSID"
#define WIFI_PASSWORD "YOUR_PASSWORD"

// --- 固定IP(任意) -----------------------------------------------------------
// WIFI_STATIC_IPを定義すると、DHCPを使わず固定IPでAPへ接続する。
// 5つセットで定義すること(DNS2が不要なら空文字""にする)。
// 4つをコメントアウトしたままにするとDHCPで取得する(既定)。
// DNSを空にするとHTTPSの名前解決だけが失敗するので、DNS1は必ず入れる。
//
// #define WIFI_STATIC_IP      "10.0.0.50"
// #define WIFI_STATIC_GATEWAY "10.0.0.1"
// #define WIFI_STATIC_NETMASK "255.255.255.0"
// #define WIFI_STATIC_DNS1    "10.0.0.1"
// #define WIFI_STATIC_DNS2    ""

// --- 予定取得APIのエンドポイント -------------------------------------------
// httpsのみ。証明書検証はESP-IDFのesp_crt_bundle(公的CAのバンドル)で行う。
#define SCHEDULE_URL  "https://example.com/api/device/schedule/xxxxxxxx"

// --- ポーリング間隔(秒) -----------------------------------------------------
// サーバ負荷との兼ね合いで既定は5分。
#define POLL_INTERVAL_SEC 300
