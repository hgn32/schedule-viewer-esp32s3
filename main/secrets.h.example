#pragma once
// このファイルのコピーを`secrets.h`として作り、自分の環境の値を入れる。
// `secrets.h`は資格情報を含むため.gitignoreで追跡から外してある。
//
//   cp main/secrets.h.example main/secrets.h

// --- Wi-Fi候補1(必須) -------------------------------------------------------
#define WIFI_SSID     "YOUR_SSID"
#define WIFI_PASSWORD "YOUR_PASSWORD"

// --- 固定IP(候補1、任意) -----------------------------------------------------
// WIFI_STATIC_IPを定義すると、候補1はDHCPを使わず固定IPでAPへ接続する。
// 5つセットで定義すること(DNS2が不要なら空文字""にする)。
// 4つをコメントアウトしたままにするとDHCPで取得する(既定)。
// DNSを空にするとHTTPSの名前解決だけが失敗するので、DNS1は必ず入れる。
//
// #define WIFI_STATIC_IP      "10.0.0.50"
// #define WIFI_STATIC_GATEWAY "10.0.0.1"
// #define WIFI_STATIC_NETMASK "255.255.255.0"
// #define WIFI_STATIC_DNS1    "10.0.0.1"
// #define WIFI_STATIC_DNS2    ""

// --- Wi-Fi候補2(任意) -------------------------------------------------------
// WIFI_SSID_2を定義すると起動時に候補として追加される。候補は起動時にスキャンし、
// 見えている候補を優先して順に試す(見えなくても後から試す)。
//
// #define WIFI_SSID_2     "YOUR_SSID_2"
// #define WIFI_PASSWORD_2 "YOUR_PASSWORD_2"
//
// 候補2に固定IPを使う場合は、末尾に_2を付けて5つセットで定義する
// (候補ごとにネットワーク設定が異なるため、候補番号ごとに独立している)。
//
// #define WIFI_STATIC_IP_2      "10.0.1.50"
// #define WIFI_STATIC_GATEWAY_2 "10.0.1.1"
// #define WIFI_STATIC_NETMASK_2 "255.255.255.0"
// #define WIFI_STATIC_DNS1_2    "10.0.1.1"
// #define WIFI_STATIC_DNS2_2    ""

// --- Wi-Fi候補3(任意) -------------------------------------------------------
// 候補2と同じ書き方で、末尾を_3にする。
//
// #define WIFI_SSID_3     "YOUR_SSID_3"
// #define WIFI_PASSWORD_3 "YOUR_PASSWORD_3"
//
// #define WIFI_STATIC_IP_3      "10.0.2.50"
// #define WIFI_STATIC_GATEWAY_3 "10.0.2.1"
// #define WIFI_STATIC_NETMASK_3 "255.255.255.0"
// #define WIFI_STATIC_DNS1_3    "10.0.2.1"
// #define WIFI_STATIC_DNS2_3    ""

// --- 予定取得APIのエンドポイント -------------------------------------------
// httpsのみ。証明書検証はESP-IDFのesp_crt_bundle(公的CAのバンドル)で行う。
#define SCHEDULE_URL  "https://example.com/api/device/schedule/xxxxxxxx"

// --- ポーリング間隔(秒) -----------------------------------------------------
// サーバ負荷との兼ね合いで既定は5分。
#define POLL_INTERVAL_SEC 300

// --- ダミー予定の表示(一時的) -----------------------------------------------
// サーバへ到達できない環境で画面を確認するための暫定手段。
// 1にするとHTTP取得を行わず、main/dummy_schedule.cppが作る予定を表示する。
// 到達性が確認できたら0に戻し、dummy_schedule.cpp/.hごと撤去する。
#define USE_DUMMY_SCHEDULE 0

// ダミーモードのときだけ使うNTPサーバ(未定義ならpool.ntp.org)。
// #define SNTP_SERVER "ntp.nict.jp"
